// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model City {
  id          Int      @id @default(autoincrement())
  slug        String   @unique
  nameEn      String
  nameHy      String?
  taglineEn   String
  taglineHy   String?
  areaKm2     Float
  foundedEn   String
  foundedHy   String?
  population  Int
  latitude    Float
  longitude   Float
  heroImage   String?
  climateEn   String?
  climateHy   String?
  bestVisitEn String?
  bestVisitHy String?
  historyEn   String?
  historyHy   String?
  sortOrder   Int      @default(0)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  places      Place[]
  hotels      Hotel[]
  attractions CityAttraction[]
  links       CityLink[]
}

enum PlaceCategory {
  MONASTERY
  FORTRESS
  NATURE
  BRIDGE
  CAVE
  VIEWPOINT
  OBSERVATORY
  MONUMENT
  WATERFALL
  TOWN
  OTHER
}

model Place {
  id            Int           @id @default(autoincrement())
  slug          String        @unique
  nameEn        String
  nameHy        String?
  shortEn       String
  shortHy       String?
  category      PlaceCategory @default(OTHER)
  icon          String?
  image         String?
  locationEn    String?
  locationHy    String?
  descriptionEn String?
  descriptionHy String?
  altitudeM     Int?
  latitude      Float?
  longitude     Float?
  featured      Boolean       @default(false)
  mostVisited   Boolean       @default(false)
  historical    Boolean       @default(false)
  sortOrder     Int           @default(0)
  published     Boolean       @default(true)
  city          City?         @relation(fields: [cityId], references: [id])
  cityId        Int?

  heritageCards HeritageCard[]

  @@index([cityId])
}

model HistorySection {
  id         Int      @id @default(autoincrement())
  slug       String   @unique
  tagEn      String?
  tagHy      String?
  titleEn    String
  titleHy    String?
  subtitleEn String?
  subtitleHy String?
  bodyEn     String
  bodyHy     String?
  quoteEn    String?
  quoteHy    String?
  image      String?
  sortOrder  Int      @default(0)
  published  Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model HeritageCard {
  id        Int      @id @default(autoincrement())
  place     Place    @relation(fields: [placeId], references: [id], onDelete: Cascade)
  placeId   Int
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([placeId])
}

model Hotel {
  id          Int      @id @default(autoincrement())
  name        String
  stars       Int      @default(4)
  address     String
  phone       String?
  priceFrom   Int
  priceTo     Int
  currency    String   @default("USD")
  score       Float
  reviewCount Int      @default(0)
  amenitiesEn String[] @default([])
  amenitiesHy String[] @default([])
  bookingUrl  String?
  sortOrder   Int      @default(0)
  published   Boolean  @default(true)
  city        City     @relation(fields: [cityId], references: [id], onDelete: Cascade)
  cityId      Int

  @@index([cityId])
}

model CityAttraction {
  id        Int     @id @default(autoincrement())
  textEn    String
  textHy    String?
  sortOrder Int     @default(0)
  city      City    @relation(fields: [cityId], references: [id], onDelete: Cascade)
  cityId    Int
}

model CityLink {
  id        Int    @id @default(autoincrement())
  label     String
  url       String
  sortOrder Int    @default(0)
  city      City   @relation(fields: [cityId], references: [id], onDelete: Cascade)
  cityId    Int
}


model RoadSection {
  id        Int     @id @default(autoincrement())
  slug      String  @unique
  tagEn     String?
  tagHy     String?
  titleEn   String
  titleHy   String?
  bodyEn    String
  bodyHy    String?
  image     String?
  sortOrder Int     @default(0)
  published Boolean @default(true)
}

model RouteStop {
  id         Int     @id @default(autoincrement())
  nameEn     String
  nameHy     String?
  distanceKm Int
  citySlug   String?
  placeSlug  String?
  sortOrder  Int     @default(0)
}

model RoadTip {
  id        Int     @id @default(autoincrement())
  titleEn   String
  titleHy   String?
  bodyEn    String
  bodyHy    String?
  sortOrder Int     @default(0)
}


model ContactMessage {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  message   String
  handled   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model SiteSetting {
  key      String  @id
  valueEn  String
  valueHy  String?
  isPublic Boolean @default(true)
}


enum Role {
  USER
  ADMIN
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  name         String?
  passwordHash String
  role         Role     @default(USER)
  createdAt    DateTime @default(now())
}